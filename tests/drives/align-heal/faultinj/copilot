#!/usr/bin/env bash
# FAULT-INJECTED worker. Scripted turns ONLY — the daemon, file.sh, the gate,
# the exit codes, the heal loop and the draft handling are all REAL.
#
#   $FI_STATE     counter file
#   $FI_DROP      how many of the brief's questions the FIRST PRD omits
#   $FI_HEALS_OK  how many heal attempts before it emits a COMPLETE PRD
#                 (0 = never fixes itself -> must exhaust the cap and escalate)
set -u
STATE="${FI_STATE:?}"; DROP="${FI_DROP:-5}"; HEALS_OK="${FI_HEALS_OK:-1}"
BRIEF="${FI_BRIEF:?}"
n=0; [ -f "$STATE" ] && n=$(cat "$STATE"); n=$((n+1)); echo "$n" > "$STATE"
prompt="$*"
is_heal=0; case "$prompt" in *"YOUR PRD WAS REFUSED"*) is_heal=1 ;; esac
hn=0; [ -f "$STATE.heal" ] && hn=$(cat "$STATE.heal")
if [ "$is_heal" = 1 ]; then hn=$((hn+1)); echo "$hn" > "$STATE.heal"; fi
# how many questions to include this time
if [ "$is_heal" = 1 ] && [ "$HEALS_OK" != 0 ] && [ "$hn" -ge "$HEALS_OK" ]; then
  OMIT=0
else
  OMIT=$DROP
fi
[ "$is_heal" = 1 ] || { [ "$n" = 1 ] && OMIT=$DROP; }
# A REAL grill asks questions before it finishes. Turn 1 must therefore be a
# QUESTION, or `sess.last_question` is never set and the session is not
# resumable for reasons that have nothing to do with the code under test.
if [ "$is_heal" = 0 ] && [ "$n" -le "${FI_QUESTIONS:-2}" ]; then
  FI_N="$n" python3 -c 'import json,os; print(json.dumps({"status":"question","question":{"text":"Scripted grill question %s - proceed?"%os.environ["FI_N"],"choices":["Proceed"],"recommended":"Proceed"},"prd":"# Mission: MBR Builder\n\n**Type:** feature\n**Goal:** _(assembling)_\n"}))'
  exit 0
fi
FI_OMIT="$OMIT" FI_BRIEF="$BRIEF" python3 - <<'PY'
import json, os, re, subprocess, sys
brief = os.environ["FI_BRIEF"]; omit = int(os.environ["FI_OMIT"])
qs = subprocess.run(["bash","-c",
    ". %s/skills/lcars-init/lcars-common.sh; lcars_concept_open_questions %s"
    % (os.environ.get("FI_REPO","/Users/roganferguson/Projects/LCARS"), brief)],
    capture_output=True, text=True).stdout.strip().split("\n")
qs = [q for q in qs if q.strip()]
keep = qs[:len(qs)-omit] if omit else qs          # DROP THE TAIL, like the real worker
lines = ["# Mission: MBR Builder", "", "**Type:** feature",
         "**Goal:** Rebuild the MBR builder to match the new mockup.", "",
         "**Acceptance Criteria:**", "- the builder renders every bucket",
         "- a month can be locked", "",
         "**Out of Scope:** the scorecard itself", "",
         "**Constraints:** must match the attached mockup", ""]
if keep:
    lines += ["## Open questions from the design session", ""]
    lines += ["- STILL OPEN: %s" % q for q in keep]
print(json.dumps({"status":"done","prd":"\n".join(lines)+"\n"}))
PY
