#!/bin/bash
# The CLAUDE-CELL counterpart to tests/drives/undrawn/blockshim/claude.
#
# On a copilot cell a claude spawn is a DEFECT, so the blockshim refuses it and
# the readout asserts the count is 0. On a claude cell a claude spawn is the
# POINT, so the assertion inverts: this shim COUNTS the spawn in exactly the
# same log format and then EXECS the real binary, so the same `grep -c '^TIME:'`
# readout line reads "how many claude workers actually ran" instead of "how many
# were refused".
#
# The real binary comes from $LCARS_REAL_CLAUDE, captured by matrix.sh with
# `command -v claude` BEFORE this directory was prepended to PATH — resolving it
# here by PATH search would find this shim again and fork-bomb.
LOG="${LCARS_BLOCK_LOG:-/tmp/lcars-claude-count.log}"
{ printf 'TIME: %s\nARGV: %s\nCWD:  %s\n---\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" "$PWD"; } >> "$LOG" 2>/dev/null
REAL="${LCARS_REAL_CLAUDE:-}"
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
  echo "countshim: \$LCARS_REAL_CLAUDE is not an executable claude ('${REAL:-unset}')." >&2
  exit 127
fi
exec "$REAL" "$@"
