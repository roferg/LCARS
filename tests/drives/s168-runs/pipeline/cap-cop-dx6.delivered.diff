diff --git a/src/lib/date.relativeAge.test.ts b/src/lib/date.relativeAge.test.ts
new file mode 100644
index 0000000..06abeef
--- /dev/null
+++ b/src/lib/date.relativeAge.test.ts
@@ -0,0 +1,65 @@
+import { describe, it, expect } from 'vitest';
+import { relativeSnapshotAge } from './date';
+
+// A fixed "now" at UTC midnight so every bucket boundary is deterministic.
+const now = new Date('2026-07-27T12:34:56Z');
+
+function idDaysBefore(days: number): string {
+  const ms = Date.UTC(2026, 6, 27) - days * 86_400_000;
+  const d = new Date(ms);
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${day}.0`;
+}
+
+describe('relativeSnapshotAge', () => {
+  it('buckets 0 whole UTC days as "today"', () => {
+    expect(relativeSnapshotAge('2026-07-27.0', now)).toBe('today');
+  });
+
+  it('buckets 1 day as "yesterday"', () => {
+    expect(relativeSnapshotAge(idDaysBefore(1), now)).toBe('yesterday');
+  });
+
+  it('buckets 2..13 days as "N days ago"', () => {
+    expect(relativeSnapshotAge(idDaysBefore(2), now)).toBe('2 days ago');
+    expect(relativeSnapshotAge(idDaysBefore(13), now)).toBe('13 days ago');
+  });
+
+  it('buckets 14..56 days as "N weeks ago" (floor of days/7)', () => {
+    expect(relativeSnapshotAge(idDaysBefore(14), now)).toBe('2 weeks ago');
+    expect(relativeSnapshotAge(idDaysBefore(20), now)).toBe('2 weeks ago');
+    expect(relativeSnapshotAge(idDaysBefore(56), now)).toBe('8 weeks ago');
+  });
+
+  it('buckets >=57 days as "N month(s) ago" (floor of days/30), singular at 1', () => {
+    expect(relativeSnapshotAge(idDaysBefore(57), now)).toBe('1 month ago');
+    expect(relativeSnapshotAge(idDaysBefore(59), now)).toBe('1 month ago');
+    expect(relativeSnapshotAge(idDaysBefore(60), now)).toBe('2 months ago');
+    expect(relativeSnapshotAge(idDaysBefore(90), now)).toBe('3 months ago');
+  });
+
+  it('floors partial days from the two UTC-midnight day values (ignores the time-of-day in now)', () => {
+    // now is 12:34 UTC; a same-calendar-day id is still 0 days => "today".
+    expect(relativeSnapshotAge('2026-07-27.5', now)).toBe('today');
+  });
+
+  it('anchors a legacy YYYY-MM id to the 1st of that month at UTC midnight', () => {
+    // 2026-06-01 is 56 days before 2026-07-27 => 8 weeks ago.
+    expect(relativeSnapshotAge('2026-06', now)).toBe('8 weeks ago');
+  });
+
+  it('returns null for a future / negative-day date (never a raw date, never NaN)', () => {
+    const result = relativeSnapshotAge('2026-07-28.0', now);
+    expect(result).toBeNull();
+    expect(result).not.toBe('2026-07-28');
+  });
+
+  it('returns null for an unparseable id without throwing or returning NaN', () => {
+    expect(relativeSnapshotAge('not-a-snapshot', now)).toBeNull();
+    expect(relativeSnapshotAge('', now)).toBeNull();
+    expect(relativeSnapshotAge('2026-13-01.0', now)).toBeNull();
+    expect(String(relativeSnapshotAge('not-a-snapshot', now))).not.toContain('NaN');
+  });
+});
diff --git a/src/lib/date.ts b/src/lib/date.ts
index 6ff9a2a..93bff86 100644
--- a/src/lib/date.ts
+++ b/src/lib/date.ts
@@ -61,3 +61,41 @@ export function snapshotLabel(snapshot: { id: string; status: 'draft' | 'locked'
   const base = snapshotIdLabel(snapshot.id);
   return snapshot.status === 'draft' ? `${base} (draft)` : base;
 }
+
+const MS_PER_DAY = 86_400_000;
+
+/**
+ * Derive a bucketed, human relative-age label for a snapshot from its id's
+ * leading UTC calendar date, reusing the same `YYYY-MM-DD` / legacy `YYYY-MM`
+ * anchoring `snapshotIdLabel` applies (ADR-003). A legacy month-keyed id anchors
+ * to the 1st of that month at UTC midnight.
+ *
+ * The age is the floor of the difference between the two UTC-midnight day
+ * values. Returns null — never NaN, never a throw, never the raw date — for an
+ * unparseable id or for a future (negative-day) date.
+ */
+export function relativeSnapshotAge(id: string, now: Date = new Date()): string | null {
+  let anchorMs: number | null = null;
+  const day = /^(\d{4})-(\d{2})-(\d{2})/.exec(id);
+  if (day) {
+    const d = new Date(`${day[1]}-${day[2]}-${day[3]}T00:00:00Z`);
+    if (!Number.isNaN(d.getTime())) anchorMs = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+  } else {
+    const month = /^(\d{4})-(\d{2})$/.exec(id);
+    if (month) {
+      const d = new Date(`${month[1]}-${month[2]}-01T00:00:00Z`);
+      if (!Number.isNaN(d.getTime())) anchorMs = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+    }
+  }
+  if (anchorMs === null) return null;
+
+  const nowMs = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
+  const days = Math.floor((nowMs - anchorMs) / MS_PER_DAY);
+  if (days < 0) return null;
+  if (days === 0) return 'today';
+  if (days === 1) return 'yesterday';
+  if (days <= 13) return `${days} days ago`;
+  if (days <= 56) return `${Math.floor(days / 7)} weeks ago`;
+  const n = Math.floor(days / 30);
+  return `${n} ${n === 1 ? 'month' : 'months'} ago`;
+}
