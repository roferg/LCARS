+import { describe, it, expect, vi } from 'vitest';
+import { render, screen } from '@testing-library/react';
+import type { Snapshot } from '../../shared/types';
+import { relativeSnapshotAge } from '../lib/date';
+import { ProvenanceBar } from './ProvenanceBar';
+
+function makeSnapshot(id: string): Snapshot {
+  return {
+    id,
+    month: id,
+    asOf: '2026-07-27',
+    generatedAt: '2026-07-27T00:00:00.000Z',
+    status: 'locked',
+    lockedBy: 'tester',
+    lockedAt: '2026-07-27T00:00:00.000Z',
+    buckets: [],
+  };
+}
+
+function renderBar(snapshotId: string) {
+  const snap = makeSnapshot(snapshotId);
+  render(
+    <ProvenanceBar
+      asOf="2026-07-27"
+      generatedAt="2026-07-27T00:00:00.000Z"
+      snapshotId={snapshotId}
+      snapshots={[snap]}
+      value={snapshotId}
+      onChange={vi.fn()}
+    />,
+  );
+}
+
+// A long-past, unambiguously non-null id (months ago) so the bucket is stable.
+const PAST_ID = '2020-01-01.0';
+// A far-future id -> relativeSnapshotAge returns null.
+const FUTURE_ID = '9999-12-31.0';
+
+describe('<ProvenanceBar /> relative snapshot age', () => {
+  it('renders the age in a span with classes meta-row__item and no-print immediately after the <select>', () => {
+    const expected = relativeSnapshotAge(PAST_ID);
+    expect(expected).not.toBeNull();
+    renderBar(PAST_ID);
+
+    const select = screen.getByRole('combobox');
+    const ageSpan = select.nextElementSibling as HTMLElement;
+    expect(ageSpan).not.toBeNull();
+    expect(ageSpan.tagName).toBe('SPAN');
+    expect(ageSpan).toHaveClass('meta-row__item', 'no-print');
+    expect(ageSpan.textContent).toBe(expected);
+  });
+
+  it('appends the same non-null age inside the print-only span as "Snapshot {id} \u00b7 {age}"', () => {
+    const expected = relativeSnapshotAge(PAST_ID);
+    renderBar(PAST_ID);
+    const printOnly = document.querySelector('.print-only') as HTMLElement;
+    expect(printOnly).not.toBeNull();
+    expect(printOnly.textContent).toBe(`Snapshot ${PAST_ID} \u00b7 ${expected}`);
+  });
+
+  it('renders no age span and a bare "Snapshot {id}" print span when the age is null', () => {
+    expect(relativeSnapshotAge(FUTURE_ID)).toBeNull();
+    renderBar(FUTURE_ID);
+
+    const select = screen.getByRole('combobox');
+    const next = select.nextElementSibling as HTMLElement;
+    // The element immediately after the select is the print-only marker, not an age span.
+    expect(next).toHaveClass('print-only');
+
+    const printOnly = document.querySelector('.print-only') as HTMLElement;
+    expect(printOnly.textContent).toBe(`Snapshot ${FUTURE_ID}`);
+    expect(printOnly.textContent).not.toContain('\u00b7');
+  });
+
+  it('styles the age span quietly: no role=status, no bold, no badge/border/accent classes', () => {
+    renderBar(PAST_ID);
+    const select = screen.getByRole('combobox');
+    const ageSpan = select.nextElementSibling as HTMLElement;
+    expect(ageSpan.getAttribute('role')).toBeNull();
+    expect(ageSpan.querySelector('strong')).toBeNull();
+    expect(ageSpan.querySelector('svg')).toBeNull();
+    expect(ageSpan.className).toBe('meta-row__item no-print');
+  });
+});
