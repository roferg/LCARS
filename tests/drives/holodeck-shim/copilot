#!/bin/bash
# LCARS holodeck argv shim — copilot. See ./claude and ./README.md.
#
#   export LCARS_SHIM_LOG=/tmp/shim-copilot.log
#   export LCARS_HOLODECK_REAL_COPILOT=/opt/homebrew/bin/copilot   # optional
set -u
self_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$self_dir/../lib/real-worker.sh"   # for _lcars_is_editor_shim — never trust
                                      # a PATH match (or the override) blindly
LOG="${LCARS_SHIM_LOG:-/tmp/lcars-holodeck-shim.log}"
REAL="${LCARS_HOLODECK_REAL_COPILOT:-}"
if [ -n "$REAL" ] && _lcars_is_editor_shim "$REAL" copilot; then
  echo "holodeck-shim: \$LCARS_HOLODECK_REAL_COPILOT ($REAL) is an editor shim — refusing it, not trusting it blindly" >&2
  REAL=""
fi
if [ -z "$REAL" ]; then
  # Resolve the real binary WITHOUT finding this shim again, AND without
  # picking an editor's own re-invocation shim for `copilot` — that shim finds
  # THIS wrapper on PATH by name and the two call each other forever (measured
  # 2026-09-15: 5,538 processes). See tests/drives/lib/real-worker.sh.
  while IFS= read -r cand; do
    case "$(cd "$(dirname "$cand")" && pwd)" in
      "$self_dir") continue ;;
    esac
    if _lcars_is_editor_shim "$cand" copilot; then
      echo "holodeck-shim: skipping $cand — that is an editor shim, not the copilot binary (it would recurse)" >&2
      continue
    fi
    REAL="$cand"; break
  done < <(type -pa copilot 2>/dev/null)
fi
{
  printf 'TIME: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'ARGV: %s\n' "$*"
  printf 'CWD:  %s\n' "$PWD"
  printf 'REAL: %s\n' "${REAL:-<not found>}"
  printf -- '---\n'
} >> "$LOG" 2>/dev/null
if [ -z "$REAL" ]; then
  echo "holodeck-shim: no real copilot found (set \$LCARS_HOLODECK_REAL_COPILOT)" >&2
  exit 127
fi
exec "$REAL" "$@"
