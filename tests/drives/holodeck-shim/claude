#!/bin/bash
# LCARS holodeck argv shim — claude.
#
# Records the FULL argv and cwd of every worker spawn, then execs the real CLI.
# `ps` cannot show you this: the daemon spawns the worker and the process is
# usually gone before you can look, and the argv is built inside the daemon from
# per-(engine, mode) tables. This shim is the only way to read the flag set the
# product ACTUALLY built during a live drive.
#
#   export LCARS_SHIM_LOG=/tmp/shim-claude.log
#   export LCARS_HOLODECK_REAL_CLAUDE=/path/to/claude     # optional
#   LCARS_WORKER_BIN=tests/drives/holodeck-shim/claude web/serve.sh …
#
# It spends whatever the real CLI spends: it is a pass-through, not a stub.
set -u
LOG="${LCARS_SHIM_LOG:-/tmp/lcars-holodeck-shim.log}"
REAL="${LCARS_HOLODECK_REAL_CLAUDE:-}"
if [ -z "$REAL" ]; then
  # resolve the real binary WITHOUT finding this shim again
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  while IFS= read -r cand; do
    case "$(cd "$(dirname "$cand")" && pwd)" in
      "$self_dir") continue ;;
      *) REAL="$cand"; break ;;
    esac
  done < <(type -pa claude 2>/dev/null)
fi
{
  printf 'TIME: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'ARGV: %s\n' "$*"
  printf 'CWD:  %s\n' "$PWD"
  printf 'REAL: %s\n' "${REAL:-<not found>}"
  printf -- '---\n'
} >> "$LOG" 2>/dev/null
if [ -z "$REAL" ]; then
  echo "holodeck-shim: no real claude found (set \$LCARS_HOLODECK_REAL_CLAUDE)" >&2
  exit 127
fi
exec "$REAL" "$@"
